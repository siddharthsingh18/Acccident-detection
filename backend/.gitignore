# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Pytest
.pytest_cache/

# Local media caches and temp uploads
media/videos/*.mp4
media/thumbnails/*.jpg
media/feeds/*.jpg
uploads/*
!uploads/.gitkeep
!media/videos/.gitkeep
!media/thumbnails/.gitkeep
!media/feeds/.gitkeep

# Environment
.env
